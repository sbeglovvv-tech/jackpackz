{
  "name": "jackpackz-backend",
  "version": "0.1.0",
  "private": true,
  "description": "JackPackz Phase 2 backend — wallet auth (SIWE) + provably-fair pack opening",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "prisma db push --skip-generate && node dist/server.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.19.1",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "prisma": "^5.19.1",
    "siwe": "^2.3.2",
    "viem": "^2.21.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "pino-pretty": "^11.2.2",
    "@types/node": "^20.14.15"
  }
}
